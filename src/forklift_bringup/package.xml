<?xml version="1.0"?>
<package format="3">
  <name>forklift_bringup</name>
  <version>0.1.0</version>
  <description>Forklift P1 simulation on ROS 2 Humble and Gazebo Fortress.</description>
  <maintainer email="thanh@localhost.local">Thanh</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>forklift_description</exec_depend>
  <exec_depend>forklift_gazebo</exec_depend>
  <exec_depend>forklift_control</exec_depend>
  <exec_depend>forklift_hardware</exec_depend>
  <exec_depend>forklift_lift</exec_depend><exec_depend>forklift_task_manager</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend><exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>forklift_navigation</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
