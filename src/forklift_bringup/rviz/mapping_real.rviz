Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: slam_toolbox::SlamToolboxPlugin
  Name: SLAM Toolbox
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Background Color: 35; 38; 45
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 0.5
  - Class: rviz_default_plugins/RobotModel
    Name: Robot
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/LaserScan
    Name: LiDAR
    Enabled: true
    Topic:
      Value: /scan
      Reliability Policy: Best Effort
    Size (m): 0.02
    Style: Points
    Color Transformer: FlatColor
    Color: 80; 220; 160
  - Class: rviz_default_plugins/Map
    Name: Occupancy Probability
    Enabled: true
    Topic:
      Value: /map_probability
      Durability Policy: Transient Local
    Alpha: 1.0
    Color Scheme: map
  - Class: rviz_default_plugins/Path
    Name: SLAM Corrected Trajectory
    Enabled: true
    Topic:
      Value: /mapping/trajectory
      Durability Policy: Transient Local
    Color: 255; 170; 40
    Line Style: Lines
    Line Width: 0.025
    Buffer Length: 1
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 70
      Target Frame: base_link
Window Geometry:
  Width: 1200
  Height: 800
