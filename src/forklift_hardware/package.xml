<?xml version="1.0"?>
<package format="3">
  <name>forklift_hardware</name><version>0.2.0</version>
  <description>Simulation-only PTY ros2_control interface and virtual MCU.</description>
  <maintainer email="thanh@localhost.local">Thanh</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>hardware_interface</depend><depend>pluginlib</depend><depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend><depend>diagnostic_msgs</depend>
  <exec_depend>rclpy</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>forklift_description</exec_depend><exec_depend>forklift_control</exec_depend>
  <exec_depend>controller_manager</exec_depend><exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend><exec_depend>python3-yaml</exec_depend><exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
